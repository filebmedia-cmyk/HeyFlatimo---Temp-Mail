# ==========================================
# KONFIGURASI DATABASE (MONGODB)
# ==========================================
# Masukkan MongoDB Connection URI Anda (Bisa dari MongoDB Atlas Free Tier / Local)
# Contoh: mongodb+srv://username:password@cluster0.abcde.mongodb.net/tmail?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/tmail

# ==========================================
# KEAMANAN WEBHOOK (CLOUDFLARE TO VERCEL)
# ==========================================
# Secret key rahasia untuk memvalidasi request dari Cloudflare Email Worker
# Buat string acak, misal: my_super_secret_token_12345
WEBHOOK_SECRET=your_super_secret_webhook_key_here

# ==========================================
# DOMAIN YANG TERSEDIA (DIPISAH KOMA)
# ==========================================
# Daftar domain yang Anda miliki di Cloudflare Email Routing
NEXT_PUBLIC_AVAILABLE_DOMAINS=mail.yourdomain.com,temp.yourdomain.com

# ==========================================
# PENGATURAN TAMBAHAN
# ==========================================
# Nama Web / Brand Personal Anda
NEXT_PUBLIC_APP_NAME=HeyFlatimo
# Masa aktif email sebelum auto-delete oleh MongoDB (dalam jam, default: 24 jam)
EMAIL_TTL_HOURS=24

# ==========================================
# ADMIN & DEVELOPER API CREDENTIALS
# ==========================================
ADMIN_USERNAME=HeyFlatimo
ADMIN_PASSWORD=TmailFlatimo
ADMIN_API_KEY=hfl_key_8899aabbccddeeff00112233
